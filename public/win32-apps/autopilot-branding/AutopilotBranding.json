{
  "Version": 1,
  "Description": "Intune Hydration Kit cleanup-only configuration for Autopilot Branding 4.0.7. No wallpaper, theme, layout, OEM, language, or app install tasks.",
  "Tasks": {
    "Rename-ABComputer": {
      "Enabled": false,
      "Parameters": {
        "NewName": "PC-%SERIAL%"
      }
    },
    "Set-ABStartLayout": {
      "Enabled": false,
      "Parameters": {
        "LayoutXmlPath": "Assets/Layout.xml",
        "Start2BinPath": "Assets/start2.bin",
        "SettingsDatPath": "Assets/settings.dat"
      }
    },
    "Set-ABTaskbarLayout": {
      "Enabled": false,
      "Parameters": {
        "TaskbarLayoutPath": "Assets/TaskbarLayoutModification.xml",
        "UnpinStore": true
      }
    },
    "Set-ABTheme": {
      "Enabled": false,
      "Parameters": {
        "ThemePath": "Assets/Autopilot.theme",
        "WallpaperPath": "Assets/Autopilot.jpg",
        "UpdateThemeWallpaper": true
      }
    },
    "Set-ABLockScreen": {
      "Enabled": false,
      "Parameters": {
        "ImagePath": "Assets/AutopilotLock.jpg"
      }
    },
    "Disable-ABStartOnFirstLogon": {
      "Enabled": true,
      "Parameters": {}
    },
    "Disable-ABDesktopSpotlight": {
      "Enabled": false,
      "Parameters": {
        "HideLearnAboutThisPicture": true,
        "DisableSpotlightCollection": true
      }
    },
    "Set-ABStartAlignment": {
      "Enabled": false,
      "Parameters": {
        "Alignment": "Left"
      }
    },
    "Hide-ABWidgets": {
      "Enabled": true,
      "Parameters": {}
    },
    "Disable-ABWidgets": {
      "Enabled": false,
      "Parameters": {
        "DisableOnLockScreen": true
      }
    },
    "Set-ABSearchBoxMode": {
      "Enabled": false,
      "Parameters": {
        "Mode": "IconOnly",
        "UsePolicy": false
      }
    },
    "Set-ABTimeZone": {
      "Enabled": false,
      "Parameters": {
        "TimeZone": ""
      }
    },
    "Remove-ABProvisionedApps": {
      "Enabled": true,
      "Parameters": {
        "AppNames": [
          "Clipchamp.Clipchamp",
          "Microsoft.BingNews",
          "Microsoft.BingWeather",
          "Microsoft.GamingApp",
          "Microsoft.GetHelp",
          "Microsoft.GetStarted",
          "Microsoft.Messaging",
          "Microsoft.Microsoft3DViewer",
          "Microsoft.MicrosoftSolitaireCollection",
          "Microsoft.MixedReality.Portal",
          "Microsoft.News",
          "Microsoft.OneConnect",
          "Microsoft.People",
          "Microsoft.Print3D",
          "Microsoft.SkypeApp",
          "microsoft.windowscommunicationsapps",
          "Microsoft.WindowsFeedbackHub",
          "Microsoft.WindowsMaps",
          "Microsoft.XboxApp",
          "Microsoft.ZuneMusic",
          "Microsoft.ZuneVideo",
          "Microsoft.Xbox.TCUI",
          "Microsoft.XboxGameOverlay",
          "Microsoft.XboxGamingOverlay",
          "Microsoft.XboxIdentityProvider",
          "Microsoft.XboxSpeechToTextOverlay",
          "MicrosoftCorporationII.MicrosoftFamily",
          "MicrosoftTeams",
          "9NHT9RB2F4HD"
        ],
        "RemoveInstalledPackages": true
      }
    },
    "Disable-ABCopilotPWA": {
      "Enabled": true,
      "Parameters": {}
    },
    "Install-ABOneDrive": {
      "Enabled": false,
      "Parameters": {
        "Url": "https://go.microsoft.com/fwlink/?linkid=844652",
        "ArmUrl": "https://go.microsoft.com/fwlink/?linkid=2282608"
      }
    },
    "Disable-ABEdgeDesktopShortcut": {
      "Enabled": true,
      "Parameters": {}
    },
    "Update-ABEdge": {
      "Enabled": true,
      "Parameters": {
        "LookUpLatest": true,
        "Url": "https://go.microsoft.com/fwlink/?LinkID=2093437",
        "ArmUrl": ""
      }
    },
    "Remove-ABEdgeBookmarks": {
      "Enabled": true,
      "Parameters": {}
    },
    "Add-ABLanguagePacks": {
      "Enabled": false,
      "Parameters": {
        "LanguagePackFolder": "Assets/LPs"
      }
    },
    "Set-ABLanguage": {
      "Enabled": false,
      "Parameters": {
        "LanguageXmlPath": "Assets/Language.xml"
      }
    },
    "Set-ABLanguageSettings": {
      "Enabled": false,
      "Parameters": {
        "Language": "en-GB",
        "Locale": "en-GB",
        "GeoId": 242
      }
    },
    "Disable-ABOptionalFeatures": {
      "Enabled": false,
      "Parameters": {
        "FeatureNames": [
          "MicrosoftWindowsPowershellV2Root",
          "WorkFolders-Client",
          "Recall",
          "MediaPlayback"
        ]
      }
    },
    "Remove-ABWindowsCapabilities": {
      "Enabled": false,
      "Parameters": {
        "CapabilityNames": [
          "App.StepsRecorder",
          "Microsoft.Windows.PowerShell.ISE"
        ]
      }
    },
    "Add-ABWindowsCapabilities": {
      "Enabled": false,
      "Parameters": {
        "CapabilityNames": [
          "Microsoft.Windows.Sense.Client~~~~",
          "WMIC"
        ],
        "BypassWsus": true
      }
    },
    "Set-ABDefaultApps": {
      "Enabled": false,
      "Parameters": {
        "AssociationsXmlPath": "Assets/Associations.xml"
      }
    },
    "Set-ABRegisteredOwner": {
      "Enabled": false,
      "Parameters": {
        "Owner": "Autopilot User",
        "Organization": "Contoso"
      }
    },
    "Set-ABOEMInfo": {
      "Enabled": false,
      "Parameters": {
        "Manufacturer": "Contoso",
        "Model": "PC",
        "UseDetectedHardware": true,
        "SupportPhone": "+1 800-555-1212",
        "SupportHours": "8am-5pm PST",
        "SupportURL": "http://www.contoso.com",
        "LogoPath": "Assets/Contoso.bmp"
      }
    },
    "Set-ABEnterpriseEdition": {
      "Enabled": false,
      "Parameters": {
        "ProductKey": "NPPR9-FWDCX-D2C8J-H872K-2YT43"
      }
    },
    "Enable-ABUEV": {
      "Enabled": false,
      "Parameters": {
        "TemplateFolder": "Assets/UEV",
        "SettingsStorageLocation": "%OneDriveCommercial%\\UEV"
      }
    },
    "Disable-ABNetworkLocationFlyout": {
      "Enabled": true,
      "Parameters": {}
    },
    "Disable-ABAutoInstalledApps": {
      "Enabled": true,
      "Parameters": {
        "DevHome": true,
        "OutlookNew": false
      }
    },
    "Install-ABWinGetPackages": {
      "Enabled": false,
      "Parameters": {
        "PackageIds": [
          "Google.Chrome",
          "9WZDNCRD29V9"
        ],
        "VCRedistUrl": "https://aka.ms/vs/17/release/vc_redist.x64.exe",
        "VCRedistArmUrl": "https://aka.ms/vs/17/release/vc_redist.arm64.exe"
      }
    },
    "Set-ABChromeConfig": {
      "Enabled": false,
      "Parameters": {
        "InitialPreferencesPath": "Assets/initial_preferences",
        "RemoveDesktopShortcut": true
      }
    },
    "Disable-ABAPv2Pages": {
      "Enabled": false,
      "Parameters": {}
    },
    "Update-ABApps": {
      "Enabled": true,
      "Parameters": {
        "UpdateInboxApps": true,
        "TriggerStoreScan": true
      }
    },
    "Disable-ABFirstLogonAnimation": {
      "Enabled": false,
      "Parameters": {}
    },
    "Remove-ABOffice": {
      "Enabled": false,
      "Parameters": {
        "OdtUrl": "https://officecdn.microsoft.com/pr/wsus/setup.exe"
      }
    },
    "Remove-ABInstalledPrograms": {
      "Enabled": false,
      "Parameters": {
        "PackageIds": [],
        "ProviderNames": [
          "msi",
          "Programs"
        ],
        "TimeoutSeconds": 600
      }
    }
  }
}
